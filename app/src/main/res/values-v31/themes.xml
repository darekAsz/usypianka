<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: same night palette as values/themes.xml plus a near-black system splash (no white flash on cold start). -->
    <style name="Theme.Usypianka" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
        <item name="android:colorBackground">@color/night_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/night_background</item>
    </style>
</resources>
